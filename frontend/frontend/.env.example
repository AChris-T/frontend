# This file is documentation only — Next.js never loads .env.example.
# Set these as real environment variables in the Vercel dashboard
# (Project → Settings → Environment Variables), then redeploy.
#
# Local dev: leave unset, both default to http://localhost:8000

# Server-side proxy target — must be your Railway BACKEND API URL (not the Vercel frontend URL)
BACKEND_URL=https://your-backend-service.up.railway.app

# Public URL for uploaded images/videos served by the backend
NEXT_PUBLIC_ASSET_URL=https://your-backend-service.up.railway.app

# ── Email notifications (Resend, app/api/notify) ──────────────────────────
# The backend POSTs to /api/notify for registration, new reports, and status
# changes. NOTIFY_SECRET must match the backend's NOTIFY_SECRET exactly.
NOTIFY_SECRET=
# Create an API key in Resend and verify the sender's domain before production.
RESEND_API_KEY=
# Must use a sender address on a domain verified in Resend.
MAIL_FROM=UI Road Monitor <notifications@your-verified-domain.com>
# Public site URL used in email links
APP_URL=https://your-frontend.vercel.app
# Optional: override the email logo. By default the backend uploads the UI logo
# to the R2 bucket (branding/ui-logo.png) and sends that URL; without R2 the
# site's /email/ui-logo.png is used.
# EMAIL_LOGO_URL=https://your-r2-public-url/branding/ui-logo.png
