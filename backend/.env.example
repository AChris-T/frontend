# Copy to .env for local development; set the same keys as Railway variables in production.

DATABASE_URL=postgresql://user:password@host:port/dbname
# JWT signing key — REQUIRED (login returns 500 without it). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public URL of the Next.js frontend (CORS + email links + notification webhook)
FRONTEND_URL=http://localhost:3000

# ── Email ──────────────────────────────────────────────────────────────
# Emails are sent by Resend in the frontend: the backend POSTs to
# NOTIFY_URL (default: FRONTEND_URL/api/notify). NOTIFY_SECRET must match the
# frontend's NOTIFY_SECRET. Set RESEND_API_KEY and MAIL_FROM in the frontend.
NOTIFY_SECRET=
# NOTIFY_URL=http://localhost:3000/api/notify
ADMIN_NOTIFICATION_EMAIL=taiwoakinfenwa2019@gmail.com

# ── Location ───────────────────────────────────────────────────────────
# Optional: Google Geocoding API key for report addresses. Without it,
# OpenStreetMap Nominatim is used (free, ~1 request/second).
GOOGLE_MAPS_API_KEY=

# ── AI ─────────────────────────────────────────────────────────────────
# Gemini Vision is the detector. Admin rescans use Gemini only; new submissions
# fall back to OpenCV heuristics if no Gemini model answers.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the primary model is out of quota / overloaded
# (each model has its own free-tier daily quota):
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash
# GEMINI_TIMEOUT_MS=45000

# ── Storage (Cloudflare R2; leave unset to store uploads on local disk) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── First admin account (created/reset by: python seed_admin.py) ────────
ADMIN_FULL_NAME=Site Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
